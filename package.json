{
  "name": "viewbox",
  "version": "0.2.0",
  "description": "Screen recorder and presenter for Figma prototypes and tutorials",
  "main": "main.js",
  "author": "John",
  "homepage": "https://jon-xvi.github.io/viewbox/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jon-xvi/viewbox.git"
  },
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "test:e2e": "node test/e2e.js",
    "check": "node test/check.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.13.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.viewbox.app",
    "npmRebuild": false,
    "productName": "ViewBox",
    "copyright": "Copyright © 2026 John",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/**/*.{md,txt}",
      "!**/*.map"
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ViewBox-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ViewBox"
    }
  }
}
